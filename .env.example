# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=change-me-long-random-string

# Optional
PORT=5000
NODE_ENV=development

# Auth gate — set to true to require Bearer tokens on protected routes.
# Leave unset/false only during solo-dev; must be true for any public deploy.
AUTH_REQUIRED=false

# Dev tooling — enables /dev/* routes and dev-only death overrides.
# NEVER set on a public deploy.
DEV_MODE=1
# Optional second layer: requests to dev routes must send x-dev-key matching this.
DEV_MODE_KEY=
